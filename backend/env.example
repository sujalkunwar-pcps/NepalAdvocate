# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# For local MongoDB (uses database `nepaladvocate` by default):
# MONGODB_URI=mongodb://127.0.0.1:27017/nepaladvocate
# For MongoDB Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nepaladvocate?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please-use-a-strong-random-string
JWT_EXPIRES_IN=7d

# File Upload Configuration
UPLOAD_DIR=./uploads

# CORS Configuration
# For development: use * (allows all origins)
# For production: specify your frontend domain(s)
# Example: CORS_ORIGIN=https://your-app.com,https://www.your-app.com
CORS_ORIGIN=*

# Sujal AI / Ollama Configuration
# The name of the model in Ollama (default is sujal)
OLLAMA_MODEL_NAME=sujal
# The base URL of the local Ollama instance
OLLAMA_URL=http://127.0.0.1:11434
# The local path where the model is fine-tuned (optional, used for startup model registration/sync)
SUJAL_AI_PATH=C:\Users\sujal\Desktop\SujalAI
