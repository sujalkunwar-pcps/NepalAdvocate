{
  "expo": {
    "name": "NepalAdvocate",
    "slug": "nepal-advocate",
    "owner": "suzza",
    "scheme": "nepaladvocate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nepaladvocate.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "NepalAdvocate requires Face ID / Biometrics for fast and secure login to your advocate and client portal."
      }
    },
    "android": {
      "package": "com.nepaladvocate.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow NepalAdvocate to use Face ID for fast and secure biometric login."
        }
      ]
    ]
  }
}
